# Copy to .env (never committed). On TrueNAS, set these as app environment variables instead.

# Yahoo developer app credentials (https://developer.yahoo.com/apps/)
YAHOO_CONSUMER_KEY=
YAHOO_CONSUMER_SECRET=
# Filled automatically after the one-time login (python -m app.yahoo_login)
YAHOO_ACCESS_TOKEN_JSON=

# Timezone for the scheduler
TZ=America/Toronto

# Where the database and token live inside the container
DATA_DIR=/data
CONFIG_PATH=/config/pools.yaml

# PoolExpert sign-in (used only when the saved session expires)
POOLEXPERT_EMAIL=
POOLEXPERT_PASSWORD=
